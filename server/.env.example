# --- Server ---
PORT=4000
JWT_SECRET=change_this_to_a_long_random_string
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:4000

# --- Provider (the SMM panel(s) you are RESELLING from) ---
# You can now add one or more providers directly from Admin -> Providers once
# the app is running - that's the recommended way, and it's how you add a
# SECOND provider if you want the panel to automatically pick whichever one
# is cheaper for each service.
#
# These two vars are ONLY used to auto-import your FIRST provider on first
# boot, for convenience. After that, manage everything from Admin -> Providers
# instead - editing these later does nothing once a provider already exists.
PROVIDER_API_URL=https://provider-domain.com/api/v2
PROVIDER_API_KEY=your_provider_api_key_here

# Percentage you add on top of the provider's rate before showing it to
# your customers, e.g. 30 = you charge 30% more than the provider charges you.
DEFAULT_MARKUP_PERCENT=30

# Most providers bill in USD. Since this panel sells in PKR, their rate is
# converted using this number every time you sync services (Admin -> Services
# -> Sync). You can also edit it later from Admin -> Payment settings.
USD_TO_PKR_RATE=278

# How often (in minutes) the panel automatically checks your provider for
# order status updates, so customers don't have to hit "Refresh" themselves.
STATUS_REFRESH_MINUTES=10

# How often (in minutes) the panel automatically re-syncs your service catalog
# (names, rates, min/max limits) from the provider, so you don't have to click
# "Sync from provider" by hand. Your markup % and active/inactive flags are
# always preserved across syncs.
SERVICE_SYNC_MINUTES=10

# --- Email (used for password reset + notifications) ---
SMTP_HOST=smtp.yourmailprovider.com
SMTP_PORT=587
SMTP_USER=you@yourdomain.com
SMTP_PASS=your_smtp_password
SMTP_FROM="Your Panel <no-reply@yourdomain.com>"

# --- Stripe (optional) ---
# Stripe does not settle to Pakistani bank accounts, so most Pakistan-based
# panels won't use this. It's here in case you have a way to accept Stripe
# (e.g. a foreign entity). Leave blank to skip it entirely - JazzCash,
# Easypaisa, and other manual top-ups (configured in Admin -> Payment
# settings once the app is running) work without this.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- First admin account ---
# On first boot, if no users exist, this account is created automatically
# as an admin so you have a way in.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password
